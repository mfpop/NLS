{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Django",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe manage.py runserver",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "label": "Backend",
        "group": "leansync",
        "panel": "dedicated",
        "reveal": "always",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Vite",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "label": "Frontend",
        "group": "leansync",
        "panel": "dedicated",
        "reveal": "always",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Start App",
      "dependsOn": ["Backend: Django", "Frontend: Vite"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
